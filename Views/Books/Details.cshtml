@model BookCatalog.Models.Book

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row align-items-center bg-white shadow-lg rounded-4 overflow-hidden border">

        <div class="col-md-4 p-0 text-center bg-light border-end">
            @if (!string.IsNullOrEmpty(Model.CoverPath))
            {
                <img src="@Model.CoverPath" class="img-fluid" alt="@Model.Title" style="max-height: 550px; width: 100%; object-fit: cover;" />
            }
            else
            {
                <div class="d-flex flex-column justify-content-center align-items-center text-muted" style="height: 450px;">
                    <i class="bi bi-book display-1"></i>
                    <p class="mt-3 fs-5">Обкладинка відсутня</p>
                </div>
            }
        </div>

        <div class="col-md-8 p-5">
            <span class="badge bg-primary mb-2 px-3 py-2 text-uppercase tracking-wide">Сторінка книги</span>
            <h1 class="display-5 fw-bolder mb-2 text-dark">@Model.Title</h1>
            <h4 class="text-muted mb-4">Автор: <span class="text-dark">@(Model.Author?.Name ?? "Невідомий")</span></h4>

            <div class="d-flex flex-wrap gap-2 mb-4">
                <span class="badge border border-secondary text-secondary fs-6 py-2 px-3">
                    Рік видання: @Model.Year
                </span>
                <span class="badge border border-secondary text-secondary fs-6 py-2 px-3">
                    Сторінок: @Model.Pages
                </span>
                @if (Model.Genres != null && Model.Genres.Any())
                {
                    foreach (var g in Model.Genres)
                    {
                        <span class="badge bg-info text-dark fs-6 py-2 px-3">@g.Name</span>
                    }
                }
            </div>

            <h5 class="fw-bold text-dark mt-4">Анотація:</h5>
            <p class="lead text-secondary" style="font-size: 1.1rem; line-height: 1.6;">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "Опис до цієї книги поки що не додано." : Model.Description)
            </p>

            @if (!string.IsNullOrEmpty(Model.Isbn))
            {
                <p class="text-muted mt-2 small"><strong>ISBN:</strong> @Model.Isbn</p>
            }

            <div class="mt-5 d-flex gap-3">
                <button class="btn btn-success btn-lg px-4 shadow-sm fw-bold">
                    Додати в "Прочитане"
                </button>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-primary btn-lg px-4 shadow-sm">
                    Редагувати
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 shadow-sm">
                    Назад до списку
                </a>
            </div>
        </div>
    </div>
</div>

<div class="fixed-bottom bg-dark text-white py-3 px-4 shadow-lg d-flex justify-content-between align-items-center" style="z-index: 1050;">
    <div class="d-flex align-items-center">
        <div>
            <span class="fw-bold fs-6 d-block">Служба підтримки BookCatalog</span>
            <span class="text-white-50 small">Знайшли помилку в описі книги або проблеми з акаунтом?</span>
        </div>
    </div>
    <div class="d-flex gap-4 fw-semibold fs-6 align-items-center">
        <a href="mailto:support@bookcatalog.ua" class="text-white text-decoration-none">
            support@bookcatalog.ua
        </a>
        <span class="d-none d-md-inline border-start border-secondary ps-4">
            +38 (099) 111-22-33
        </span>
    </div>
</div>

<div style="height: 90px;"></div>