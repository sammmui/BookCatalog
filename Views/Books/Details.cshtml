@model BookCatalog.Models.Book

@{
    ViewData["Title"] = Model.Title;
}

<style>
    html { scroll-behavior: smooth; }
    section[id] { scroll-margin-top: 70px; }
</style>

<nav class="navbar navbar-expand bg-white border-bottom sticky-top shadow-sm">
    <div class="container">
        <span class="navbar-brand fw-bold text-truncate">@Model.Title</span>
        <ul class="navbar-nav ms-auto">
            <li class="nav-item"><a class="nav-link" href="#about">Про книгу</a></li>
            <li class="nav-item"><a class="nav-link" href="#author">Автор</a></li>
            <li class="nav-item"><a class="nav-link" href="#details">Деталі</a></li>
        </ul>
    </div>
</nav>

<header class="bg-light py-5 border-bottom">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-md-4 text-center">
                @if (!string.IsNullOrEmpty(Model.CoverPath))
                {
                    <img src="@Model.CoverPath" class="img-fluid rounded-4 shadow-lg" alt="@Model.Title"
                         style="max-height: 480px; object-fit: cover;" />
                }
                else
                {
                    <div class="d-flex flex-column justify-content-center align-items-center text-muted bg-white rounded-4 shadow-sm"
                         style="height: 400px;">
                        <i class="bi bi-book display-1"></i>
                        <p class="mt-3 fs-5">Обкладинка відсутня</p>
                    </div>
                }
            </div>
            <div class="col-md-8">
                <span class="badge bg-primary mb-3 px-3 py-2 text-uppercase">Сторінка книги</span>
                <h1 class="display-4 fw-bolder">@Model.Title</h1>
                <h4 class="text-muted mb-4">@(Model.Author?.Name ?? "Невідомий автор")</h4>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    @if (Model.Year != null)
                    {
                        <span class="badge border border-secondary text-secondary fs-6 py-2 px-3">
                            <i class="bi bi-calendar3"></i> @Model.Year
                        </span>
                    }
                    <span class="badge border border-secondary text-secondary fs-6 py-2 px-3">
                        <i class="bi bi-file-earmark-text"></i> @Model.Pages стор.
                    </span>
                    @foreach (var g in Model.Genres)
                    {
                        <span class="badge bg-info text-dark fs-6 py-2 px-3">@g.Name</span>
                    }
                </div>

                <div class="d-flex gap-3">
                    <a href="#about" class="btn btn-primary btn-lg px-4 shadow-sm">Читати далі</a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-lg px-4">Редагувати</a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">До списку</a>
                </div>
            </div>
        </div>
    </div>
</header>

<section id="about" class="py-5">
    <div class="container">
        <h2 class="fw-bold mb-4">Про книгу</h2>
        <p class="lead text-secondary" style="line-height: 1.7;">
            @(string.IsNullOrWhiteSpace(Model.Description) ? "Опис до цієї книги поки що не додано." : Model.Description)
        </p>
    </div>
</section>

<section id="author" class="py-5 bg-light border-top border-bottom">
    <div class="container">
        <h2 class="fw-bold mb-4">Автор</h2>
        <div class="bg-white shadow-sm rounded-4 p-4 border">
            <h4 class="fw-bold">@(Model.Author?.Name ?? "Невідомий автор")</h4>
            @if (Model.Author != null && (!string.IsNullOrEmpty(Model.Author.BirthPlace) || Model.Author.BirthYear != null))
            {
                <p class="text-muted mb-0">
                    <i class="bi bi-geo-alt"></i> @Model.Author.BirthPlace
                    @if (Model.Author.BirthYear != null)
                    {
                        <span>, @Model.Author.BirthYear р.</span>
                    }
                </p>
            }
            else
            {
                <p class="text-muted mb-0">Інформація про автора поки що не додана.</p>
            }
        </div>
    </div>
</section>

<section id="details" class="py-5">
    <div class="container">
        <h2 class="fw-bold mb-4">Деталі видання</h2>
        <div class="row g-4">
            <div class="col-6 col-md-3">
                <div class="bg-white shadow-sm rounded-4 p-4 border text-center h-100">
                    <i class="bi bi-calendar3 fs-2 text-primary"></i>
                    <div class="fw-bold fs-4">@(Model.Year?.ToString() ?? "—")</div>
                    <div class="text-muted">Рік видання</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="bg-white shadow-sm rounded-4 p-4 border text-center h-100">
                    <i class="bi bi-file-earmark-text fs-2 text-primary"></i>
                    <div class="fw-bold fs-4">@Model.Pages</div>
                    <div class="text-muted">Сторінок</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="bg-white shadow-sm rounded-4 p-4 border text-center h-100">
                    <i class="bi bi-upc-scan fs-2 text-primary"></i>
                    <div class="fw-bold fs-5">@(string.IsNullOrEmpty(Model.Isbn) ? "—" : Model.Isbn)</div>
                    <div class="text-muted">ISBN</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="bg-white shadow-sm rounded-4 p-4 border text-center h-100">
                    <i class="bi bi-tags fs-2 text-primary"></i>
                    <div class="fw-bold fs-4">@Model.Genres.Count</div>
                    <div class="text-muted">Жанрів</div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="fixed-bottom bg-dark text-white py-3 px-4 shadow-lg d-flex justify-content-between align-items-center"
     style="z-index: 1050;">
    <div>
        <span class="fw-bold d-block">Служба підтримки BookCatalog</span>
        <span class="text-white-50 small d-none d-md-inline">Знайшли помилку в описі книги?</span>
    </div>
    <div class="d-flex gap-4 fw-semibold align-items-center">
        <a href="mailto:support@bookcatalog.ua" class="text-white text-decoration-none">
            <i class="bi bi-envelope"></i> support@bookcatalog.ua
        </a>
        <span class="d-none d-md-inline border-start border-secondary ps-4">
            <i class="bi bi-telephone"></i> +38 (099) 111-22-33
        </span>
    </div>
</div>

<div style="height: 90px;"></div>