    {
      "name": "3. Get books page",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\nconst j = pm.response.json();\r\npm.test(\"Has items array\", () => pm.expect(j.items).to.be.an(\"array\"));\r\npm.test(\"Limit respected\", () => pm.expect(j.items.length).to.be.at.most(2));\r\npm.test(\"Has total\", () => pm.expect(j.total).to.be.a(\"number\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books?skip=0&limit=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books"
          ],
          "query": [
            {
              "key": "skip",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "2"
            }
          ]
        }
      },
      "response": []
    },
